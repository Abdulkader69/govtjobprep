# ---- exam API -------------------------------------------------------------
# local  = grade in the browser. Development and demo only: the bank ships
#          to the client, so the answers are readable in devtools.
# http   = grade on the server. Use this in production.
VITE_API_MODE=local
VITE_API_BASE=/api

# ---- accounts (Firebase) --------------------------------------------------
# firebase = Firebase Auth + Firestore; one device per account. Default when
#            the VITE_FIREBASE_* values below are set.
# local    = the browser trusts itself. No server, no OTP, no device limit.
VITE_AUTH_MODE=firebase

# Firebase console → Project settings → Your apps → Web app → SDK config.
# These are public identifiers; security lives in firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Phone OTP needs the Blaze plan (billing attached, pay per SMS). Leave false
# on the free Spark plan; email/password works there.
VITE_PHONE_LOGIN=false

# replace = a new device signs the old one out (default).
# block   = the new device is refused until the old one signs out or the
#           session is older than VITE_SESSION_TTL_DAYS.
VITE_SESSION_POLICY=replace
VITE_SESSION_TTL_DAYS=30
# Where an unlocked account gets the full bank. firestore = uploaded with
# `npm run bank:upload`, read under firestore.rules. bundle = import the JSON
# (development only — it puts every question in the public build).
VITE_BANK_SOURCE=firestore

# ---- npm run bank:upload only (never reaches the bundle) ------------------
# The super-admin account the upload script signs in as. Leave blank to be
# asked interactively.
FIREBASE_ADMIN_EMAIL=
FIREBASE_ADMIN_PASSWORD=

# Floating "message the admin" button for signed-in accounts without full
# access. A Messenger link: https://m.me/<your Facebook username or Page name>.
# Leave empty to hide the button.
VITE_ADMIN_MESSENGER=
